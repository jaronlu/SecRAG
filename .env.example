# 复制为 .env 并填入真实值：cp .env.example .env

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=["*"]

# 产品 profile（MVP 收敛）："knowledge_qa" 只暴露产品文档与 FAQ 检索（默认）；
# "full" 恢复完整工具路径（开发/评估/回退用）。非法值启动时直接报错
PRODUCT_PROFILE=knowledge_qa

# LLM provider 切换："openai"（OpenAI 兼容接口，如火山方舟 Ark/DeepSeek）或 "ollama"（本地模型）
LLM_PROVIDER=openai

# provider=ollama 时生效
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1

# provider=openai 时生效：火山方舟 Ark（OpenAI 兼容）
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
# 注意：glm 系（如 glm-5.3-flash）在该端点为强制 reasoning 模型，思考 token
# 计入 max_tokens，会烧空理解/规划调用的输出预算（plan_max_tokens）导致静默
# 降级与整体超时；deepseek 系思考 token 不计入 max_tokens，可正常工作
OPENAI_MODEL=glm-5.3-flash
# 必填：provider=openai 时若为空会在启动时报错
OPENAI_API_KEY=

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Local SQLite storage
AUDIT_DB_PATH=./data/audit.db
CONVERSATION_DB_PATH=./data/conversations.db

# Langfuse — Agent/LLM 链路观测，默认关闭；Cloud/自托管选型未定，开启前先确认
LANGFUSE_ENABLED=false
# 自托管时改为实例地址；默认 Langfuse Cloud
LANGFUSE_HOST=https://cloud.langfuse.com
# 项目 API 密钥（Langfuse 控制台 → Settings → API Keys），enabled=true 时必填
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 采样比例 0.0~1.0，1.0 = 全量；开发可全量，生产按比例采样
LANGFUSE_SAMPLE_RATE=1.0
# 内容捕获默认关闭：问题/回答/文档原文不进 payload；开发调试需显式开启并经统一脱敏
LANGFUSE_CAPTURE_CONTENT=false
